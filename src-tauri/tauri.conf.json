{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gallium",
  "version": "1.0.0",
  "identifier": "app.gallium.browser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "gtheme"
        ],
        "name": "Gallium Theme",
        "description": "Gallium theme",
        "role": "Viewer",
        "mimeType": "application/x-gallium-theme"
      },
      {
        "ext": [
          "gmod"
        ],
        "name": "Gallium Mod",
        "description": "Gallium mod",
        "role": "Viewer",
        "mimeType": "application/x-gallium-mod"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "category": "Productivity",
    "shortDescription": "An Arc-style browser"
  }
}
